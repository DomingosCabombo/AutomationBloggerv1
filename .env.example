# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=audio-jobs

# ── Python microservice ───────────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:8000

# ── API server ────────────────────────────────────────────────
PORT=3000

# ── Worker settings ───────────────────────────────────────────
WORKER_INTERVAL_MS=60000   # 1 minute
